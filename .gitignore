# === AuditPPI .gitignore ===
# Track source, config, and scripts.
# Do NOT track large data lakes, audit products, vendored upstream repos,
# model weights, tests, or manuscripts.

# --- Large data / vendored upstream (tens of GB; reached via conf/paths.py) ---
/data/
/external/
/baselines/

# --- Retired data/scripts kept locally for provenance (layer-mismatched *_old
#     caches, superseded cache builders); never version-controlled ---
/backups/

# --- Audit products (regenerable; layered under results/{audit_*,analysis,main}/) ---
/results/

# --- Runtime logs / ad-hoc shell chains (not experiment provenance) ---
/logs/
# Driver stdout captured next to the scripts that emit it (scripts/*/runs/*.log,
# scripts/*/runs/_logs/). The launcher .sh files ARE tracked; their output is not.
*.log
_logs/
.latest_pending_log

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Tests (kept locally, not version-controlled) ---
/tests/

# --- Manuscript (kept locally, not version-controlled) ---
/manuscripts/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editable-install / packaging artifacts ---
*.egg-link

# --- OS / editor cruft ---
.DS_Store
*.swp
.idea/
.vscode/

# --- Matplotlib scratch dir some scripts set ---
/tmp/matplotlib-auditppi/
