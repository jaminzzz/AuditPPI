# === AuditPPI .gitignore ===
# Track source, config, tests, scripts, and the manuscript.
# Do NOT track large data lakes, vendored upstream repos, or model weights.

# --- Large data / vendored upstream (tens of GB; reached via conf/paths.py) ---
/data/
/external/
/baselines/

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editable-install / packaging artifacts ---
*.egg-link

# --- OS / editor cruft ---
.DS_Store
*.swp
.idea/
.vscode/

# --- Matplotlib scratch dir some scripts set ---
/tmp/matplotlib-auditppi/
